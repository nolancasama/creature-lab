; Engine configuration file.
; Creature Lab - a 3D classroom ESL game for "It was... Now it is..."

config_version=5

[application]

config/name="Creature Lab"
config/description="Programme an animal's DNA with spoken English, then build a zoo."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Content="*res://scripts/autoload/content_library.gd"
GraphicsQuality="*res://scripts/autoload/graphics_quality.gd"
Settings="*res://scripts/autoload/settings_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
Game="*res://scripts/autoload/game_state.gd"
Router="*res://scripts/autoload/scene_router.gd"
Audio="*res://scripts/autoload/audio_manager.gd"
Tts="*res://scripts/autoload/tts_service.gd"
Speech="*res://scripts/autoload/speech_service.gd"
Voice="*res://scripts/autoload/voice_recorder.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; Bundled rather than relying on the system: Godot falls back to an OS font for glyphs its
; built-in font lacks, which covers Japanese on Windows and covers nothing in a browser -
; the web build simply drew blanks where the UI text and the tick marks should have been.
; Subset of Noto Sans JP (SIL Open Font License), carrying ASCII, every kana, the kanji this
; project actually uses, and the tick. See ui/noto_sans_jp_subset_ATTRIBUTION.txt.
theme/custom_font="res://ui/noto_sans_jp_subset.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
